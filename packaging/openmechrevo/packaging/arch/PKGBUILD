prepare() {
  cd "${srcdir}/tuxedo-drivers-v${pkgver}"

  local patch_file
  for patch_file in "${srcdir}"/*.patch; do
    if [ -f "${patch_file}" ]; then
      msg2 "Applying patch: $(basename "${patch_file}")"
      patch -Np1 -i "${patch_file}"
    fi
  done
}

package() {
  install -Dm644 "${srcdir}/dkms.conf" "${pkgdir}/usr/src/${_pkgname}-${pkgver}/dkms.conf"
  sed -i "s/#MODULE_VERSION#/${pkgver}/g" "${pkgdir}/usr/src/${_pkgname}-${pkgver}/dkms.conf"

  install -Dm644 "${srcdir}/60-mechrevo.rules" "${pkgdir}/usr/lib/udev/rules.d/60-mechrevo.rules"

  cd "${srcdir}/tuxedo-drivers-v${pkgver}"
  install -Dm644 files/usr/lib/modprobe.d/*.conf -t "${pkgdir}/usr/lib/modprobe.d/" 2>/dev/null || true
  install -Dm644 files/usr/lib/udev/rules.d/*.rules -t "${pkgdir}/usr/lib/udev/rules.d/" 2>/dev/null || true
  install -Dm644 files/usr/lib/udev/hwdb.d/*.hwdb -t "${pkgdir}/usr/lib/udev/hwdb.d/" 2>/dev/null || true

  mkdir -p "${pkgdir}/usr/src/${_pkgname}-${pkgver}"
  cp -ar src/* "${pkgdir}/usr/src/${_pkgname}-${pkgver}/"
}
