From ea2333887837a5624572673b2d62582ccd5a853e Mon Sep 17 00:00:00 2001
From: Railgun-wiki <64968531+Railgun-wiki@users.noreply.github.com>
Date: Thu, 3 Sep 2026 16:29:19 +0800
Subject: [PATCH] uniwill: extend EC abstraction with model-scoped register map

Introduce struct uniwill_ec_regmap to abstract model-specific EC register
offsets (performance mode, power LED, TDP limits, TCC thermal limit,
fan curve tables, fan boost, and dGPU power capability) rather than
relying on hardcoded addresses.

Generated via archetype platform inheritance with model-specific overrides,
the regmap encodes CPU architecture, mode masks, dGPU/MUX capability,
and dynamic fan table parameters.

Append the regmap pointer at the end of struct uniwill_device_features_t
to preserve existing field offsets. Devices without matching quirks default
to default_uniwill_regmap, ensuring zero functional regression across
existing platforms.

Signed-off-by: Railgun-wiki <64968531+Railgun-wiki@users.noreply.github.com>
---
 src/uniwill_interfaces.h      |   4 +
 src/uniwill_keyboard.h        |  18 ++
 src/uniwill_mechrevo_quirks.h | 444 ++++++++++++++++++++++++++++++++++
 3 files changed, 466 insertions(+)
 create mode 100644 src/uniwill_mechrevo_quirks.h

diff --git a/src/uniwill_interfaces.h b/src/uniwill_interfaces.h
index 2b3edac..ed88134 100644
--- a/src/uniwill_interfaces.h
+++ b/src/uniwill_interfaces.h
@@ -141,6 +141,8 @@ int uniwill_get_active_interface_id(char **id_str);
 #define UW_MODEL_PH4TQF		0x14
 #define UW_MODEL_PH4AQF_ARX	0x17
 
+struct uniwill_ec_regmap;
+
 struct uniwill_device_features_t {
 	u8 model;
 	/**
@@ -169,6 +171,8 @@ struct uniwill_device_features_t {
 	bool uniwill_has_usb_powershare;
 	bool uniwill_has_mini_led_local_dimming;
 	bool uniwill_has_hidden_bios_options;
+	/* Model-scoped register map indirection for address decoding */
+	const struct uniwill_ec_regmap *regmap;
 };
 
 struct uniwill_device_features_t *uniwill_get_device_features(void);
diff --git a/src/uniwill_keyboard.h b/src/uniwill_keyboard.h
index c3216ae..158099e 100644
--- a/src/uniwill_keyboard.h
+++ b/src/uniwill_keyboard.h
@@ -39,6 +39,7 @@
 #include <acpi/battery.h>
 #include "uniwill_interfaces.h"
 #include "uniwill_leds.h"
+#include "uniwill_mechrevo_quirks.h"
 
 #define FAN_ON_MIN_SPEED_PERCENT 25
 
@@ -1798,6 +1799,10 @@ struct uniwill_device_features_t *uniwill_get_device_features(void)
 	}
 
 
+	uw_feats->regmap = uniwill_match_ec_regmap();
+	if (!uw_feats->regmap)
+		uw_feats->regmap = &default_uniwill_regmap;
+
 	if (feats_loaded)
 		pr_debug("feats loaded\n");
 	else
@@ -1809,6 +1814,19 @@ struct uniwill_device_features_t *uniwill_get_device_features(void)
 }
 EXPORT_SYMBOL(uniwill_get_device_features);
 
+/*
+ * Retrieve active register map for the identified motherboard.
+ * Falls back to default hardcoded addresses for non-target models (zero regression).
+ */
+static inline const struct uniwill_ec_regmap *uniwill_get_active_regmap(void)
+{
+	struct uniwill_device_features_t *feats = uniwill_get_device_features();
+
+	if (feats && feats->regmap)
+		return feats->regmap;
+	return &default_uniwill_regmap;
+}
+
 // Fn lock
 
 static int uniwill_wmi_fn_lock_get(int *on)
