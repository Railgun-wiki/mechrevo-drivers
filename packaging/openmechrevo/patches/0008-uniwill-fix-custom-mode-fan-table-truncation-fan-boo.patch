+static int uniwill_get_perf_mode_info(u8 *out_mode, bool *is_custom)
+{
+	const struct uniwill_ec_regmap *regmap = uniwill_get_active_regmap();
+	u8 val = 0, cflag = 0;
+	int ret;
+
+	if (is_custom) {
+		*is_custom = false;
+		if (uniwill_read_ec_ram(0x0726, &cflag) == 0 && (cflag & BIT(7)))
+			*is_custom = true;
+	}
+
+	ret = uniwill_read_ec_ram(regmap->reg_perf_mode, &val);
+	if (ret)
+		return ret;
+
+	if (out_mode)
+		*out_mode = val & 0xBF; /* Mask out bit 6 (FanBoost) */
+
+	return 0;
+}
+
+static int uniwill_set_perf_mode_info(u8 base_mode, u8 led_mode, bool custom)
+{
+	const struct uniwill_ec_regmap *regmap = uniwill_get_active_regmap();
+	u8 cur_perf = 0, cflag = 0, lflag = 0, led_val = 0;
+	int ret;
+
+	/* 1. Read current perf register to preserve bit 6 (FanBoost) */
+	ret = uniwill_read_ec_ram(regmap->reg_perf_mode, &cur_perf);
+	if (ret)
+		return ret;
+
+	cur_perf = (cur_perf & 0x40) | (base_mode & ~0x40);
+	ret = uniwill_write_ec_ram(regmap->reg_perf_mode, cur_perf);
+	if (ret)
+		return ret;
+
+	/* 2. Configure custom flags in 0x0726 (bit 7) and 0x0727 (bit 6) */
+	if (uniwill_read_ec_ram(0x0726, &cflag) == 0) {
+		if (custom)
+			cflag |= BIT(7);
+		else
+			cflag &= ~BIT(7);
+		uniwill_write_ec_ram(0x0726, cflag);
+	}
+	if (uniwill_read_ec_ram(0x0727, &lflag) == 0) {
+		if (custom)
+			lflag |= BIT(6);
+		else
+			lflag &= ~BIT(6);
+		uniwill_write_ec_ram(0x0727, lflag);
+	}
+
+	/* 3. Synchronize power LED status bits 1:0 preserving other bits */
+	if (uniwill_read_ec_ram(regmap->reg_power_led, &led_val) == 0) {
+		led_val = (led_val & ~0x03) | (led_mode & 0x03);
+		uniwill_write_ec_ram(regmap->reg_power_led, led_val);
+	}
+
+	uniwill_notify_platform_profile();
+	return 0;
+}
