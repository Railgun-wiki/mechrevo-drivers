+static ssize_t tdp_fppt_store(struct device *dev, struct device_attribute *attr,
+			      const char *buf, size_t count)
+{
+	const struct uniwill_ec_regmap *regmap = uniwill_get_active_regmap();
+	unsigned int val;
+	u8 write_val = 0, readback = 0;
+	bool double_pl4 = false;
+	int ret;
+
+	if (kstrtouint(buf, 0, &val))
+		return -EINVAL;
+
+	val = clamp_val(val, regmap->tdp_fppt_min, regmap->tdp_fppt_max);
+	has_double_pl4(&double_pl4);
+	if (double_pl4)
+		write_val = (u8)(val / 2);
+	else
+		write_val = (u8)val;
+
+	ret = uniwill_write_ec_ram(regmap->reg_tdp_fppt, write_val);
+	if (ret)
+		return ret;
+
+	ret = uniwill_read_ec_ram(regmap->reg_tdp_fppt, &readback);
+	if (ret || readback != write_val)
+		return -EIO;
+
+	return count;
