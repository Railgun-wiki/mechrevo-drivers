+	if (off >= total_size)
+		return 0;
+	if (off + count > total_size)
+		count = total_size - off;
+
+	for (i = 0; i < regmap->fan_points; i++) {
+		u8 upt = 0, downt = 0, duty = 0;
+
+		if (i * 3 + 2 < off || i * 3 >= off + count)
+			continue;
+
+		/* Point 0 UpT is 0 C base; points 1..10 read from offsets 0..9 */
+		if (i == 0) {
+			upt = 0;
+		} else {
+			uniwill_read_ec_ram(regmap->reg_fan_curve_gpu + i - 1, &upt);
+		}
+
+		/* DownT for point i is in EC offset i + 1 (clamp slot 15 to offset 15 to stay within DownT table) */
+		u8 down_idx = (i < regmap->fan_points - 1) ? (i + 1) : i;
+		uniwill_read_ec_ram(regmap->reg_fan_curve_gpu +
+				    regmap->fan_down_temp_offset + down_idx, &downt);
+
+		uniwill_read_ec_ram(regmap->reg_fan_curve_gpu +
+				    regmap->fan_duty_offset + i, &duty);
+		if (regmap->fan_duty_scale)
+			duty /= regmap->fan_duty_scale;
+
+		if (i * 3 >= off && i * 3 < off + count)
+			buf[i * 3 - off] = upt;
+		if (i * 3 + 1 >= off && i * 3 + 1 < off + count)
+			buf[i * 3 + 1 - off] = downt;
+		if (i * 3 + 2 >= off && i * 3 + 2 < off + count)
+			buf[i * 3 + 2 - off] = duty;
+	}
+
+	return count;
+}
+
+static ssize_t fan_curve2_write(struct file *filp, struct kobject *kobj,
+				UW_BIN_ATTR_ARG bin_attr,
+				char *buf, loff_t off, size_t count)
+{
+	const struct uniwill_ec_regmap *regmap = uniwill_get_active_regmap();
+	size_t total_size;
+	int i;
+
+	if (!regmap || !regmap->has_fan_table || regmap->fan_points == 0)
+		return -EOPNOTSUPP;
+
+	total_size = regmap->fan_points * 3;
+	if (off != 0 || count != total_size)
+		return -EINVAL;
+
+	/* UpT: Points 1..regmap->fan_points-1 written to offsets 0..regmap->fan_points-2; rest clamped to 0xFF */
+	for (i = 0; i < 16; i++) {
+		u8 upt_val = (i < regmap->fan_points - 1) ? buf[(i + 1) * 3] : 0xFF;
+		uniwill_write_ec_ram(regmap->reg_fan_curve_gpu + i, upt_val);
+	}
+
+	/* DownT: Points 0..regmap->fan_points-1 written to offsets 1..regmap->fan_points; offset 0 set to 0 */
+	for (i = 0; i < 16; i++) {
+		u8 downt_val;
+		if (i == 0)
+			downt_val = 0;
+		else if (i <= regmap->fan_points)
+			downt_val = buf[(i - 1) * 3 + 1];
+		else
+			downt_val = 0xFF;
+		uniwill_write_ec_ram(regmap->reg_fan_curve_gpu +
+				     regmap->fan_down_temp_offset + i, downt_val);
+	}
+
+	/* Duty: Points 0..regmap->fan_points-1 scaled; rest clamped to 100 * scale */
+	for (i = 0; i < 16; i++) {
+		u8 duty_val;
+		if (i < regmap->fan_points) {
+			u8 d = buf[i * 3 + 2];
+			if (d > 100)
+				d = 100;
+			duty_val = regmap->fan_duty_scale ?
+				(d * regmap->fan_duty_scale) : d;
+		} else {
+			duty_val = regmap->fan_duty_scale ?
+				(100 * regmap->fan_duty_scale) : 100;
+		}
+		uniwill_write_ec_ram(regmap->reg_fan_curve_gpu +
+				     regmap->fan_duty_offset + i, duty_val);
+	}
+
+	/* Assert RAM fan table enable (0x07C6 bit 2) and respective control (0x07C5 bit 7) */
+	{
+		u8 en_val = 0;
+
+		if (uniwill_read_ec_ram(0x07C6, &en_val) == 0) {
+			en_val |= BIT(2);
+			uniwill_write_ec_ram(0x07C6, en_val);
+		}
+		if (uniwill_read_ec_ram(0x07C5, &en_val) == 0) {
+			en_val |= BIT(7);
+			uniwill_write_ec_ram(0x07C5, en_val);
+		}
+	}
+
+	return count;
+}
