+	if (regmap->supported_modes_mask & UNIWILL_MODE_CUSTOM_BIT)
+		set_bit(PLATFORM_PROFILE_CUSTOM, uniwill_pprof_handler.choices);
+	uniwill_pprof_handler.dev = dev;
