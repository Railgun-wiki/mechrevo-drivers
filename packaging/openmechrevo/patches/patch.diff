+/*
+ * Matches string with either shell glob pattern or substring search.
+ * Zero heap allocation, safe for early boot and kernel DMI matching.
+ */
+static inline bool uniwill_dmi_match_string(const char *pattern, const char *str)
+{
+	if (!pattern || !str)
+		return false;
+	if (strchr(pattern, '*') || strchr(pattern, '?') || strchr(pattern, '['))
+		return glob_match(pattern, str);
+	return strstr(str, pattern) != NULL;
+}
+
+/* Lookup model regmap from system DMI table */
+static inline const struct uniwill_ec_regmap *uniwill_match_ec_regmap(void)
+{
+	const struct uniwill_dmi_regmap_entry *entry;
+	const char *sys_vendor = dmi_get_system_info(DMI_SYS_VENDOR);
+	const char *board_vendor = dmi_get_system_info(DMI_BOARD_VENDOR);
+	const char *board_name = dmi_get_system_info(DMI_BOARD_NAME);
+	const char *product_name = dmi_get_system_info(DMI_PRODUCT_NAME);
+	bool is_mechrevo = false;
+
+	if ((sys_vendor && strstr(sys_vendor, "MECHREVO")) ||
+	    (board_vendor && strstr(board_vendor, "MECHREVO")))
+		is_mechrevo = true;
+
+	/* Pass 1: Strict board_name match (highest priority) */
+	for (entry = uniwill_dmi_regmap_table; entry->regmap != NULL; entry++) {
+		if (!entry->board_name)
+			continue;
+		if (entry->vendor) {
+			bool vendor_match = false;
+			if (sys_vendor && strstr(sys_vendor, entry->vendor))
+				vendor_match = true;
+			if (board_vendor && strstr(board_vendor, entry->vendor))
+				vendor_match = true;
+			if (!vendor_match)
+				continue;
+		}
+		if (board_name && uniwill_dmi_match_string(entry->board_name, board_name))
+			return entry->regmap;
+	}
+
+	/* Pass 2: Secondary product_name match */
+	for (entry = uniwill_dmi_regmap_table; entry->regmap != NULL; entry++) {
+		if (!entry->product_name)
+			continue;
+		if (entry->vendor) {
+			bool vendor_match = false;
+			if (sys_vendor && strstr(sys_vendor, entry->vendor))
+				vendor_match = true;
+			if (board_vendor && strstr(board_vendor, entry->vendor))
+				vendor_match = true;
+			if (!vendor_match)
+				continue;
+		}
+		if (product_name && uniwill_dmi_match_string(entry->product_name, product_name))
+			return entry->regmap;
+	}
+
+	/* If MECHREVO vendor detected but specific model not matched, fall back to generic */
+	if (is_mechrevo)
+		return &generic_uniwill_regmap;
+
+	return &default_uniwill_regmap;
+}
